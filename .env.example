# ---------------------------------------------------------------------------
# GitConnect environment variables
#
# Copy to `.env.local` for local development, or paste these into your host's
# dashboard (Cloudflare Pages / Netlify / Vercel).
#
# NEVER commit real values. `.env*.local` is git-ignored.
# ---------------------------------------------------------------------------

# --- Required: GitHub App credentials --------------------------------------

# Numeric App ID from Settings > Developer settings > GitHub Apps > your app.
GH_APP_ID=123456

# Contents of the downloaded .pem file.
# Single-line form: replace real newlines with the two characters \n.
GH_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Numeric ID from the URL of the app's installation settings page:
# https://github.com/settings/installations/<GH_INSTALLATION_ID>
GH_INSTALLATION_ID=12345678

# --- Required: where submissions go ----------------------------------------

# Map each form category to a Discussion node ID.
# Keys must match the `value` fields in public/config.js.
# See docs/SETUP.md for how to look these IDs up.
DISCUSSION_IDS={"general":"D_kwDO...","feature":"D_kwDO...","bug":"D_kwDO...","feedback":"D_kwDO..."}

# Alternative to the JSON above — one variable per category:
# DISCUSSION_ID_GENERAL=D_kwDO...
# DISCUSSION_ID_BUG=D_kwDO...

# --- Recommended -----------------------------------------------------------

# Comma-separated list of origins allowed to POST to the API.
# Leave unset for same-origin only (the default when the form and function are
# deployed together). Use "*" for local testing only.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Optional: spam protection ---------------------------------------------

# Cloudflare Turnstile secret key. When set, submissions must include a valid
# token; also set `turnstileSiteKey` in public/config.js.
# TURNSTILE_SECRET_KEY=

# --- Optional: misc --------------------------------------------------------

# User-Agent sent to the GitHub API.
# USER_AGENT=gitconnect-contact-form

# Set to "true" to return upstream error details to the client. Local only.
# DEBUG=false
